# Copy this file to terraform.tfvars and fill it in. terraform.tfvars is ignored
# by git, so your email address and account details stay on your machine.

alert_emails = ["you@example.com"]

# Printed by the bootstrap step as state_bucket.
state_bucket = "clairo-tfstate-123456789012"

# The part after vercel.com/ when you open your team on Vercel.
vercel_team_slug = "your-team"

