# A Google AI Studio key switches on chat, definitions, AI lab extraction and
# cloud semantic search. Without one, everything else still works.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional overrides, as "provider/model". The chat setting takes a list: the
# first model answers, and the rest are backups tried in order if it fails.
# AI_CHAT_MODEL=google/gemini-3.7-flash,bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0
# AI_EMBEDDING_MODEL=google/gemini-embedding-001

# Claude on Amazon Bedrock. On a laptop, name the AWS CLI profile you signed in
# with (run `aws sso login --profile clairo` first). On Vercel, set AWS_ROLE_ARN
# instead, from `terraform output vercel_role_arn`. No AWS keys go here.
# AWS_PROFILE=clairo
# AWS_ROLE_ARN=
# BEDROCK_REGION=us-east-1
